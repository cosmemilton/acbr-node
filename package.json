{
  "name": "@cosmemilton/acbr-node",
  "version": "0.1.0",
  "description": "NF-e/NFC-e com ACBr Free Pascal, cliente TypeScript gerado e CLI SVN",
  "license": "LGPL-2.1-or-later",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/src/index.d.ts",
  "bin": {
    "acbr-node": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./runtime": {
      "types": "./dist/types/src/runtime.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "native",
    "tools",
    "LICENSE",
    "NOTICE",
    "README.md",
    "docs",
    "scripts/build-native-deps.mjs",
    "acbr.lock.json",
    "acbr.config.json"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:cli": "node scripts/build.mjs --cli-only",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.mjs tests/*.test.ts",
    "test:native": "node --import tsx --test test/native*.mjs",
    "acbr": "tsx src/cli.ts",
    "pack:runtimes": "node scripts/pack-runtimes.mjs",
    "release:prepare": "node scripts/publish-artifacts.mjs",
    "test:package": "node tests/package-install.mjs"
  },
  "optionalDependencies": {
    "@cosmemilton/acbr-node-linux-x64": "0.1.0",
    "@cosmemilton/acbr-node-win32-x64": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "node-forge": "^1.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosmemilton/acbr-node.git"
  },
  "homepage": "https://miltonjunior.dev.br/acbr-node/",
  "bugs": {
    "url": "https://github.com/cosmemilton/acbr-node/issues"
  }
}
